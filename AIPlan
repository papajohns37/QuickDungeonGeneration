Phase 4: Unity C# Integration Layer
Write a clean C# wrapper that handles P/Invoke bindings and memory pointers safely.
NativeLevelBridge.cs
C#
using System;
using System.Runtime.InteropServices;
using UnityEngine;

public static class NativeLevelBridge
{
    private const string DllName = "NativeLevelGen";

    [StructLayout(LayoutKind.Sequential)]
    public struct LevelConfig
    {
        public int width;
        public int height;
        public int seed;
        public int minRoomSize;
        public int maxRooms;
    }

    [DllImport(DllName, CallingConvention = CallingConvention.Cdecl)]
    public static extern void GenerateLevel(LevelConfig config, IntPtr outMapData);
}

Fast Unity Tilemap Rendering Script
Use Tilemap.SetTilesBlock or Unity's unsafe native arrays for high performance:
LevelGeneratorManager.cs
C#
using System;
using System.Runtime.InteropServices;
using UnityEngine;
using UnityEngine.Tilemaps;

public class LevelGeneratorManager : MonoBehaviour
{
    [SerializeField] private Tilemap tilemap;
    [SerializeField] private TileBase wallTile;
    [SerializeField] private TileBase floorTile;

    public void Generate(int width, int height, int seed)
    {
        int totalCells = width * height;
        byte[] mapBuffer = new byte[totalCells];

        // Pin managed memory buffer to send unmanaged pointer to C++
        GCHandle handle = GCHandle.Alloc(mapBuffer, GCHandleType.Pinned);
        try
        {
            var config = new NativeLevelBridge.LevelConfig
            {
                width = width,
                height = height,
                seed = seed,
                minRoomSize = 6,
                maxRooms = 15
            };

            NativeLevelBridge.GenerateLevel(config, handle.AddrOfPinnedObject());
        }
        finally
        {
            handle.Free();
        }

        // Apply grid directly to Unity Tilemap
        ApplyToTilemap(mapBuffer, width, height);
    }

    private void ApplyToTilemap(byte[] mapData, int width, int height)
    {
        tilemap.ClearAllTiles();
        TileBase[] tileArray = new TileBase[mapData.Length];

        for (int i = 0; i < mapData.Length; i++)
        {
            tileArray[i] = mapData[i] switch
            {
                1 => wallTile,
                2 => floorTile,
                _ => null
            };
        }

        BoundsInt bounds = new BoundsInt(0, 0, 0, width, height, 1);
        tilemap.SetTilesBlock(bounds, tileArray);
    }
}

